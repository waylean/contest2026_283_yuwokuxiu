<template>
  <div class="page">
    <div class="header">
      <text class="title">真机诊断采集</text>
      <text class="state">{{stateText}}</text>
    </div>

    <div class="card">
      <text class="stageLabel">阶段 {{stageNumber}} / 6</text>
      <text class="stageName">{{stageName}}</text>
      <text class="stageHint">预期 {{expectedCount}} 次 · 事件 {{eventCount}}</text>
      <div class="row">
        <div class="smallButton" onclick="decreaseExpected">
          <text class="smallButtonText">- 次数</text>
        </div>
        <div class="smallButton" onclick="increaseExpected">
          <text class="smallButtonText">+ 次数</text>
        </div>
      </div>
      <div class="wideButton" onclick="toggleStage">
        <text class="wideButtonText">{{stageButtonText}}</text>
      </div>
      <div class="wideButton secondary" onclick="nextStage">
        <text class="wideButtonText">{{nextButtonText}}</text>
      </div>
    </div>

    <text class="message">{{message}}</text>
    <text class="session">匿名会话 {{sessionShort}}</text>

    <div class="footer">
      <div class="dangerButton" onclick="stopCapture">
        <text class="footerText">停止采集</text>
      </div>
      <div class="exitButton" onclick="exitApp">
        <text class="footerText">保存并退出</text>
      </div>
    </div>

    <div class="startOverlay" if="{{showStart}}">
      <text class="overlayTitle">BMT 诊断工具</text>
      <text class="overlayText">仅保存候选事件窗口，不采集身份、位置、视频或账号。</text>
      <div class="overlayButton" onclick="startNewSession">
        <text class="overlayButtonText">新建匿名会话</text>
      </div>
      <div class="overlayButton recoverButton" if="{{canRecover}}" onclick="recoverSession">
        <text class="overlayButtonText">恢复未导出会话</text>
      </div>
      <div class="overlayButton exitOverlayButton" onclick="exitApp">
        <text class="overlayButtonText">退出</text>
      </div>
      <text class="overlayError">{{errorText}}</text>
    </div>
  </div>
</template>

<style>
  .page {
    width: 480px;
    height: 686px;
    background-color: #10131a;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
    padding-bottom: 18px;
  }

  .header {
    width: 424px;
    height: 54px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    color: #ffffff;
    font-size: 27px;
    font-weight: bold;
  }

  .state {
    color: #76e6a7;
    font-size: 20px;
  }

  .card {
    width: 424px;
    height: 440px;
    background-color: #1b2130;
    border-radius: 24px;
    flex-direction: column;
    align-items: center;
    padding-top: 22px;
    margin-top: 10px;
  }

  .stageLabel {
    color: #9da8ba;
    font-size: 21px;
  }

  .stageName {
    color: #ffffff;
    font-size: 42px;
    font-weight: bold;
    margin-top: 8px;
  }

  .stageHint {
    color: #c5cfdd;
    font-size: 22px;
    margin-top: 10px;
  }

  .row {
    width: 360px;
    height: 58px;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 16px;
  }

  .smallButton {
    width: 170px;
    height: 54px;
    background-color: #303a50;
    border-radius: 18px;
    align-items: center;
    justify-content: center;
  }

  .smallButtonText {
    color: #ffffff;
    font-size: 22px;
  }

  .wideButton {
    width: 360px;
    height: 66px;
    background-color: #1e8e5a;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    margin-top: 15px;
  }

  .secondary {
    background-color: #3b465c;
    margin-top: 12px;
  }

  .wideButtonText {
    color: #ffffff;
    font-size: 25px;
    font-weight: bold;
  }

  .message {
    width: 424px;
    height: 34px;
    color: #d5dbea;
    font-size: 20px;
    text-align: center;
    margin-top: 9px;
  }

  .session {
    width: 424px;
    height: 24px;
    color: #7f8a9d;
    font-size: 17px;
    text-align: center;
  }

  .footer {
    width: 424px;
    height: 62px;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 7px;
  }

  .dangerButton {
    width: 202px;
    height: 60px;
    background-color: #a43b45;
    border-radius: 19px;
    align-items: center;
    justify-content: center;
  }

  .exitButton {
    width: 202px;
    height: 60px;
    background-color: #39445a;
    border-radius: 19px;
    align-items: center;
    justify-content: center;
  }

  .footerText {
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
  }

  .startOverlay {
    width: 480px;
    height: 686px;
    position: absolute;
    left: 0px;
    top: 0px;
    background-color: #10131a;
    flex-direction: column;
    align-items: center;
    padding-top: 76px;
  }

  .overlayTitle {
    color: #ffffff;
    font-size: 38px;
    font-weight: bold;
  }

  .overlayText {
    width: 390px;
    height: 100px;
    color: #c5cfdd;
    font-size: 22px;
    text-align: center;
    margin-top: 18px;
  }

  .overlayButton {
    width: 370px;
    height: 70px;
    background-color: #1e8e5a;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
  }

  .recoverButton {
    background-color: #486093;
  }

  .exitOverlayButton {
    background-color: #39445a;
  }

  .overlayButtonText {
    color: #ffffff;
    font-size: 25px;
    font-weight: bold;
  }

  .overlayError {
    width: 390px;
    color: #ff9ca5;
    font-size: 19px;
    text-align: center;
    margin-top: 15px;
  }
</style>

<script>
  import {
    createPlayerGeometry,
    estimateSwingMetrics,
    isRecoveryReturn,
    scoreSwingQuality
  } from '../common/scripts/captureSwingAlgorithm.js'
  import {
    createInterconnectSender
  } from '../common/scripts/interconnectExport.js'

  const FORMAT_VERSION = 'bmt-capture-v1'
  const ACTIVE_MANIFEST_KEY = 'bmt_capture_active_manifest_v1'
  const EXPORT_MANIFEST_KEY = 'bmt_capture_export_manifest_v1'
  const STAGE_NAMES = ['静止', '步行', '普通摆臂', '持拍回位', '过顶空挥', '实际击球']
  const DEFAULT_EXPECTED = [0, 0, 20, 10, 20, 20]
  const GRAVITY = 9.80665
  const RING_SAMPLES = 50
  const POST_WINDOW_MS = 1000
  const MAX_EVENTS_PER_CHUNK = 1
  const MAX_CHUNKS = 120

  function clamp (value, min, max) {
    return Math.max(min, Math.min(max, Number(value) || 0))
  }

  function round3 (value) {
    return Math.round((Number(value) || 0) * 1000) / 1000
  }

  function checksum (text) {
    let hash = 2166136261
    for (let i = 0; i < text.length; i = i + 1) {
      hash = hash ^ text.charCodeAt(i)
      hash = Math.imul(hash, 16777619)
    }
    return ('00000000' + (hash >>> 0).toString(16)).slice(-8)
  }

  export default {
    private: {
      showStart: true,
      canRecover: false,
      running: false,
      stageIndex: 0,
      stageNumber: 1,
      stageName: '静止',
      expectedCount: 0,
      eventCount: 0,
      stageActive: false,
      stageButtonText: '开始本阶段',
      nextButtonText: '下一阶段',
      stateText: '待开始',
      message: '请选择新会话或恢复',
      errorText: '',
      sessionId: '',
      sessionShort: '--------',
      exportPrepared: false,
      startedAt: 0,
      endedAt: 0,
      stages: [],
      chunkRefs: [],
      chunkEvents: [],
      chunkIndex: 0,
      ring: [],
      seq: 0,
      lastTimestamp: 0,
      sampleIntervalMs: 20,
      gravityReady: false,
      gravityX: 0,
      gravityY: 0,
      gravityZ: GRAVITY,
      lastMagnitude: 0,
      lastDynX: 0,
      lastDynY: 0,
      lastDynZ: 0,
      energyAvg: 0,
      warmupUntil: 0,
      swingActive: false,
      pendingCandidate: null,
      swingStart: 0,
      swingLastActive: 0,
      swingPeakAt: 0,
      swingPeakAccel: 0,
      swingPeakJerk: 0,
      swingPeakEnergy: 0,
      swingSamples: 0,
      swingHighSamples: 0,
      swingQuietSamples: 0,
      swingAccelSum: 0,
      swingAccelSqSum: 0,
      swingImpulse: 0,
      swingPosX: 0,
      swingNegX: 0,
      swingPosY: 0,
      swingNegY: 0,
      swingPosZ: 0,
      swingNegZ: 0,
      swingWindowSamples: [],
      lastAcceptedEvent: null,
      lastSwingTimestamp: -1000000,
      recentPeakTimes: [],
      recentPeakAccels: [],
      mediumPeakLocked: false,
      pendingStorageWrites: 0,
      exportRequested: false,
      interconnectSender: null,
      interconnectSending: false,
      interconnectProgress: '',
      interconnectError: ''
    },

    onInit () {
      this.initInterconnect()
      this.loadRecoverableSession()
    },

    onDestroy () {
      this.safeStopSensor()
      if (this.interconnectSender && this.interconnectSender.close) {
        this.interconnectSender.close()
      }
      if (this.sessionId) this.persistManifest(this.endedAt === 0)
    },

    initInterconnect () {
      try {
        var ic = require('@system.interconnect')
        this.interconnectSender = createInterconnectSender(ic)
      } catch (err) {
        this.interconnectSender = null
      }
    },

    onHide () {
      if (this.running) this.persistManifest(true)
    },

    onBackPress () {
      if (!this.running) return false
      this.message = '请使用保存并退出'
      this.persistManifest(true)
      return true
    },

    loadRecoverableSession () {
      const vm = this
      try {
        const storage = require('@system.storage')
        storage.get({
          key: ACTIVE_MANIFEST_KEY,
          default: '',
          success: function (data) {
            const raw = typeof data === 'string' ? data : data && data.value
            if (!raw) return
            try {
              const saved = JSON.parse(raw)
              if (saved && saved.session && saved.session.id && !saved.session.exportedAt) {
                vm.canRecover = true
                vm.recoveredManifest = saved
              }
            } catch (err) {
              vm.errorText = '恢复索引损坏，可新建会话'
            }
          }
        })
      } catch (err) {
        this.errorText = '存储不可用，仍可安全退出'
      }
    },

    startNewSession () {
      const now = Date.now()
      this.sessionId = 'cap-' + now.toString(36) + '-' +
        Math.floor(Math.random() * 0x100000000).toString(36)
      this.exportPrepared = false
      this.sessionShort = this.sessionId.slice(-8)
      this.startedAt = now
      this.endedAt = 0
      this.stageIndex = 0
      this.stages = []
      this.chunkRefs = []
      this.chunkEvents = []
      this.chunkIndex = 0
      this.seq = 0
      this.prepareStage()
      this.showStart = false
      this.startSensor()
    },

    recoverSession () {
      const saved = this.recoveredManifest
      if (!saved || !saved.session) {
        this.errorText = '没有可恢复会话'
        return
      }
      this.sessionId = saved.session.id
      this.exportPrepared = false
      this.sessionShort = this.sessionId.slice(-8)
      this.startedAt = saved.session.startedAt
      this.endedAt = 0
      this.stageIndex = clamp(saved.currentStageIndex, 0, 5)
      this.stages = saved.stages || []
      this.chunkRefs = saved.chunks || []
      this.chunkIndex = this.chunkRefs.length
      this.seq = Number(saved.nextSampleSeq) || 0
      this.lastAcceptedEvent = saved.lastAcceptedEvent || null
      this.prepareStage()
      if (saved.currentExpectedCount !== undefined && !this.stageActive) {
        this.expectedCount = clamp(saved.currentExpectedCount, 0, 99)
      }
      this.showStart = false
      this.message = '已恢复，继续使用新事件窗口'
      this.startSensor()
    },

    prepareStage () {
      this.stageNumber = this.stageIndex + 1
      this.stageName = STAGE_NAMES[this.stageIndex]
      this.expectedCount = DEFAULT_EXPECTED[this.stageIndex]
      this.eventCount = 0
      this.stageActive = false
      for (let i = 0; i < this.stages.length; i = i + 1) {
        const item = this.stages[i]
        if (item.index === this.stageIndex) {
          this.expectedCount = item.expectedCount
          this.eventCount = item.eventCount || 0
          if (!item.endedAt) {
            this.stageActive = true
          }
        }
      }
      this.stageButtonText = this.stageActive ? '结束本阶段' : '开始本阶段'
      this.nextButtonText = this.stageIndex === 5 ? '生成导出索引' : '下一阶段'
    },

    startSensor () {
      const vm = this
      try {
        const sensor = require('@system.sensor')
        sensor.subscribeAccelerometer({
          interval: 'game',
          callback: function (ret) {
            try {
              vm.handleSample(ret)
            } catch (err) {
              vm.handleRuntimeFailure('采样处理异常')
            }
          },
          fail: function (msg, code) {
            vm.handleRuntimeFailure('传感器失败 ' + code)
          }
        })
        this.running = true
        this.warmupUntil = Date.now() + 1800
        this.stateText = 'game 20ms'
        this.message = '稳定佩戴，等待基线'
        this.persistManifest(true)
      } catch (err) {
        this.handleRuntimeFailure('传感器启动异常')
      }
    },

    safeStopSensor () {
      this.running = false
      try {
        const sensor = require('@system.sensor')
        sensor.unsubscribeAccelerometer()
      } catch (err) {}
    },

    handleRuntimeFailure (message) {
      this.safeStopSensor()
      this.stateText = '已安全停止'
      this.message = message + '，数据已保留'
      this.errorText = message
      this.persistManifest(true)
    },

    decreaseExpected () {
      if (this.stageActive) {
        this.message = '阶段进行中不可修改次数'
        return
      }
      this.expectedCount = Math.max(0, this.expectedCount - 1)
      this.persistManifest(true)
    },

    increaseExpected () {
      if (this.stageActive) {
        this.message = '阶段进行中不可修改次数'
        return
      }
      this.expectedCount = Math.min(99, this.expectedCount + 1)
      this.persistManifest(true)
    },

    toggleStage () {
      const now = Date.now()
      if (!this.stageActive) {
        this.stages.push({
          index: this.stageIndex,
          name: this.stageName,
          expectedCount: this.expectedCount,
          startedAt: now,
          endedAt: 0,
          eventCount: 0
        })
        this.stageActive = true
        this.eventCount = 0
        this.stageButtonText = '结束本阶段'
        this.message = '阶段已开始'
      } else {
        const stage = this.currentStageRecord()
        if (stage) {
          stage.endedAt = now
          stage.eventCount = this.eventCount
        }
        this.stageActive = false
        this.stageButtonText = '开始本阶段'
        this.message = '阶段已结束并保存'
      }
      this.persistManifest(true)
    },

    currentStageRecord () {
      for (let i = this.stages.length - 1; i >= 0; i = i - 1) {
        if (this.stages[i].index === this.stageIndex && !this.stages[i].endedAt) {
          return this.stages[i]
        }
      }
      return null
    },

    nextStage () {
      if (this.stageActive) {
        this.message = '请先结束当前阶段'
        return
      }
      if (this.stageIndex < 5) {
        this.stageIndex = this.stageIndex + 1
        this.prepareStage()
        this.persistManifest(true)
        this.message = '已切换阶段'
        return
      }
      this.prepareExport()
    },

    handleSample (ret) {
      if (!this.running) return
      const now = Date.now()
      const x = Number(ret.x) || 0
      const y = Number(ret.y) || 0
      const z = Number(ret.z) || 0
      const rawMagnitude = Math.sqrt(x * x + y * y + z * z)
      const measuredDt = this.lastTimestamp ? now - this.lastTimestamp : 20
      const measuredDtMs = Math.max(1, measuredDt)
      const analysisDtMs = Math.max(20, measuredDt)
      const dt = Math.min(0.08, analysisDtMs / 1000)
      const gravityAlpha = dt / (0.82 + dt)

      if (!this.gravityReady) {
        this.gravityX = x
        this.gravityY = y
        this.gravityZ = z
        this.gravityReady = true
      } else {
        this.gravityX = this.gravityX * (1 - gravityAlpha) + x * gravityAlpha
        this.gravityY = this.gravityY * (1 - gravityAlpha) + y * gravityAlpha
        this.gravityZ = this.gravityZ * (1 - gravityAlpha) + z * gravityAlpha
      }

      const dynX = x - this.gravityX
      const dynY = y - this.gravityY
      const dynZ = z - this.gravityZ
      const dynAccel = Math.sqrt(dynX * dynX + dynY * dynY + dynZ * dynZ)
      const rawAccel = Math.max(0, Math.abs(rawMagnitude - GRAVITY))
      const motionAccel = Math.max(dynAccel, rawAccel * 0.82)
      const jerkX = dynX - this.lastDynX
      const jerkY = dynY - this.lastDynY
      const jerkZ = dynZ - this.lastDynZ
      const dynJerk = Math.sqrt(jerkX * jerkX + jerkY * jerkY + jerkZ * jerkZ) / dt
      const rawJerk = Math.abs(rawMagnitude - this.lastMagnitude) / dt
      const jerk = Math.max(dynJerk, rawJerk * 0.8)
      const energy = motionAccel * motionAccel
      const smoothedEnergy = this.energyAvg
        ? this.energyAvg * 0.78 + energy * 0.22
        : energy
      const sample = {
        seq: this.seq,
        t: now,
        x: round3(x),
        y: round3(y),
        z: round3(z),
        dt: measuredDtMs
      }
      this.seq = this.seq + 1
      this.ring.push(sample)
      if (this.ring.length > RING_SAMPLES) this.ring.shift()
      if (this.pendingCandidate) this.pendingCandidate.samples.push(sample)
      else if (this.swingActive) this.swingWindowSamples.push(sample)

      this.sampleIntervalMs = Math.round(
        this.sampleIntervalMs * 0.8 + analysisDtMs * 0.2
      )
      this.lastTimestamp = now
      this.lastMagnitude = rawMagnitude
      this.lastDynX = dynX
      this.lastDynY = dynY
      this.lastDynZ = dynZ
      this.energyAvg = smoothedEnergy
      this.recordMediumPeak(now, motionAccel, jerk)

      if (this.pendingCandidate && now >= this.pendingCandidate.postUntil) {
        this.commitCandidate(this.pendingCandidate)
        this.pendingCandidate = null
      }
      if (now < this.warmupUntil || this.pendingCandidate) return

      const active = motionAccel > 5.2 || jerk > 86
      const startBurst = (motionAccel > 8.8 && jerk > 122) || motionAccel > 13
      const sinceLastSwing = now - this.lastSwingTimestamp
      const previousPeak = this.lastAcceptedEvent
        ? Number(this.lastAcceptedEvent.peakAccel) || 0
        : 0
      const strongContinuation = previousPeak > 0 &&
        motionAccel > previousPeak * 0.92 && jerk > 130
      const canStart = sinceLastSwing > 320 ||
        (sinceLastSwing > 230 && strongContinuation)
      if (active && startBurst && canStart && !this.swingActive) {
        this.beginSwing(now)
      }
      if (!this.swingActive) return

      this.swingSamples = this.swingSamples + 1
      if (motionAccel > this.swingPeakAccel) {
        this.swingPeakAccel = motionAccel
        this.swingPeakAt = now
      }
      this.swingPeakJerk = Math.max(this.swingPeakJerk, jerk)
      this.swingPeakEnergy = Math.max(this.swingPeakEnergy, smoothedEnergy)
      if (motionAccel > Math.max(3.2, this.swingPeakAccel * 0.46)) {
        this.swingHighSamples = this.swingHighSamples + 1
      }
      this.swingAccelSum = this.swingAccelSum + motionAccel
      this.swingAccelSqSum = this.swingAccelSqSum + energy
      this.swingImpulse = this.swingImpulse + motionAccel * dt
      if (dynX >= 0) this.swingPosX = this.swingPosX + dynX * dt
      else this.swingNegX = this.swingNegX - dynX * dt
      if (dynY >= 0) this.swingPosY = this.swingPosY + dynY * dt
      else this.swingNegY = this.swingNegY - dynY * dt
      if (dynZ >= 0) this.swingPosZ = this.swingPosZ + dynZ * dt
      else this.swingNegZ = this.swingNegZ - dynZ * dt

      if (active) {
        this.swingLastActive = now
        this.swingQuietSamples = 0
      } else {
        this.swingQuietSamples = this.swingQuietSamples + 1
      }
      if (now - this.swingStart > 640 || this.swingQuietSamples >= 5 ||
        now - this.swingLastActive > 150) {
        this.finishSwing(now)
      }
    },

    beginSwing (now) {
      this.swingActive = true
      this.swingStart = now
      this.swingLastActive = now
      this.swingPeakAt = now
      this.swingPeakAccel = 0
      this.swingPeakJerk = 0
      this.swingPeakEnergy = 0
      this.swingSamples = 0
      this.swingHighSamples = 0
      this.swingQuietSamples = 0
      this.swingAccelSum = 0
      this.swingAccelSqSum = 0
      this.swingImpulse = 0
      this.swingPosX = 0
      this.swingNegX = 0
      this.swingPosY = 0
      this.swingNegY = 0
      this.swingPosZ = 0
      this.swingNegZ = 0
      this.swingWindowSamples = this.ring.slice(0)
    },

    finishSwing (now) {
      const durationMs = Math.max(60, now - this.swingStart)
      const avgAccel = this.swingSamples > 0 ? this.swingAccelSum / this.swingSamples : 0
      const dominantImpulse = Math.max(
        this.swingPosX, this.swingNegX, this.swingPosY,
        this.swingNegY, this.swingPosZ, this.swingNegZ
      )
      const metrics = {
        peakAccel: round3(this.swingPeakAccel),
        peakJerk: round3(this.swingPeakJerk),
        peakEnergy: round3(this.swingPeakEnergy),
        avgAccel: round3(avgAccel),
        energyIntegral: round3(this.swingAccelSqSum *
          Math.min(0.08, this.sampleIntervalMs / 1000)),
        burstRatio: round3(this.swingPeakAccel / Math.max(1.2, avgAccel)),
        directionRatio: round3(dominantImpulse / Math.max(0.1, this.swingImpulse)),
        impulse: round3(this.swingImpulse),
        dominantImpulse: round3(dominantImpulse),
        durationMs: durationMs,
        peakLatencyMs: Math.max(0, this.swingPeakAt - this.swingStart),
        halfWidthMs: this.swingHighSamples * this.sampleIntervalMs,
        intervalMs: this.sampleIntervalMs,
        samples: this.swingSamples,
        runningLike: this.isRunningLike()
      }
      const quality = scoreSwingQuality(metrics)
      let accepted = quality.accepted
      let reason = quality.reason
      let estimate = null
      if (accepted) {
        estimate = estimateSwingMetrics(
          { ...metrics, qualityScore: quality.score },
          createPlayerGeometry({ heightCm: 175, strapIndex: 1 })
        )
        const acceptedEvent = {
          at: now,
          peakAccel: metrics.peakAccel,
          impulse: Math.max(metrics.impulse, metrics.dominantImpulse),
          racketSpeedKmh: estimate.racketSpeedKmh
        }
        if (isRecoveryReturn(acceptedEvent, this.lastAcceptedEvent)) {
          accepted = false
          reason = '回位'
        } else {
          this.lastAcceptedEvent = acceptedEvent
          this.lastSwingTimestamp = now
        }
      }
      this.pendingCandidate = {
        id: this.sessionId + '-e' + this.totalSavedEvents(),
        stageIndex: this.stageIndex,
        stageName: this.stageName,
        stageActive: this.stageActive,
        startedAt: this.swingStart,
        endedAt: now,
        postUntil: now + POST_WINDOW_MS,
        accepted: accepted,
        reason: reason,
        algorithmRevision: 'competition-swing-2026-07-27',
        features: metrics,
        qualityScore: quality.score,
        estimate: estimate,
        samples: this.swingWindowSamples.slice(0)
      }
      this.swingActive = false
      this.message = (accepted ? '接受 ' : '拒绝 ') + reason
    },

    recordMediumPeak (now, accel, jerk) {
      if (accel > 6.4 && jerk > 48 && !this.mediumPeakLocked) {
        this.recentPeakTimes.push(now)
        this.recentPeakAccels.push(accel)
        if (this.recentPeakTimes.length > 3) this.recentPeakTimes.shift()
        if (this.recentPeakAccels.length > 3) this.recentPeakAccels.shift()
        this.mediumPeakLocked = true
      } else if (accel < 3.2) {
        this.mediumPeakLocked = false
      }
    },

    isRunningLike () {
      if (this.recentPeakTimes.length < 3) return false
      const interval1 = this.recentPeakTimes[1] - this.recentPeakTimes[0]
      const interval2 = this.recentPeakTimes[2] - this.recentPeakTimes[1]
      const averageInterval = (interval1 + interval2) / 2
      const intervalSpread = Math.abs(interval1 - interval2) /
        Math.max(1, averageInterval)
      const averageAccel = (this.recentPeakAccels[0] +
        this.recentPeakAccels[1] + this.recentPeakAccels[2]) / 3
      const accelSpread = Math.max(
        Math.abs(this.recentPeakAccels[0] - averageAccel),
        Math.abs(this.recentPeakAccels[1] - averageAccel),
        Math.abs(this.recentPeakAccels[2] - averageAccel)
      ) / Math.max(1, averageAccel)
      return interval1 >= 260 && interval1 <= 760 &&
        interval2 >= 260 && interval2 <= 760 &&
        intervalSpread < 0.24 && accelSpread < 0.45
    },

    commitCandidate (candidate) {
      delete candidate.postUntil
      this.chunkEvents.push(candidate)
      this.eventCount = this.eventCount + 1
      const stage = this.currentStageRecord()
      if (stage) stage.eventCount = this.eventCount
      if (this.chunkEvents.length >= MAX_EVENTS_PER_CHUNK) this.flushChunk()
      else this.persistManifest(true)
    },

    totalSavedEvents () {
      let count = this.chunkEvents.length
      for (let i = 0; i < this.chunkRefs.length; i = i + 1) {
        count = count + (this.chunkRefs[i].eventCount || 0)
      }
      return count
    },

    flushChunk () {
      if (!this.chunkEvents.length) return
      if (this.chunkIndex >= MAX_CHUNKS) {
        this.handleRuntimeFailure('达到有限存储上限')
        return
      }
      const key = 'bmt_capture_chunk_' + this.sessionId + '_' + this.chunkIndex
      const payload = {
        formatVersion: FORMAT_VERSION,
        sessionId: this.sessionId,
        index: this.chunkIndex,
        createdAt: Date.now(),
        events: this.chunkEvents
      }
      const payloadText = JSON.stringify(payload)
      const record = {
        payload: payload,
        checksum: checksum(payloadText)
      }
      const reference = {
        index: this.chunkIndex,
        key: key,
        eventCount: this.chunkEvents.length,
        checksum: record.checksum,
        serializedLength: JSON.stringify(record).length
      }
      this.chunkEvents = []
      this.chunkIndex = this.chunkIndex + 1
      this.chunkRefs.push(reference)
      try {
        const storage = require('@system.storage')
        const vm = this
        this.pendingStorageWrites = this.pendingStorageWrites + 1
        storage.set({
          key: key,
          value: JSON.stringify(record),
          success: function () {
            vm.pendingStorageWrites = Math.max(0, vm.pendingStorageWrites - 1)
            if (!vm.exportPrepared) {
              vm.persistManifest(vm.running && vm.endedAt === 0)
            }
            if (vm.exportRequested) vm.tryPrepareExport()
          },
          fail: function () {
            vm.pendingStorageWrites = Math.max(0, vm.pendingStorageWrites - 1)
            vm.handleRuntimeFailure('分块保存失败')
          }
        })
      } catch (err) {
        this.handleRuntimeFailure('分块保存异常')
      }
    },

    buildManifest (active) {
      return {
        formatVersion: FORMAT_VERSION,
        captureApp: {
          package: 'com.waylean.bmtsmash.capture',
          version: '0.1.0',
          sensor: 'system.sensor accelerometer',
          requestedInterval: 'game',
          nominalIntervalMs: 20,
          preWindowMs: 1000,
          postWindowMs: POST_WINDOW_MS
        },
        privacy: {
          anonymousSession: true,
          collected: ['accelerometer', 'stage-labels', 'timestamps', 'algorithm-features'],
          excluded: ['name', 'location', 'device-key', 'video', 'account']
        },
        session: {
          id: this.sessionId,
          startedAt: this.startedAt,
          endedAt: active ? 0 : this.endedAt,
          active: Boolean(active),
          exportedAt: 0
        },
        currentStageIndex: this.stageIndex,
        currentExpectedCount: this.expectedCount,
        stages: this.stages,
        chunks: this.chunkRefs,
        pendingEventCount: this.chunkEvents.length,
        nextSampleSeq: this.seq,
        lastAcceptedEvent: this.lastAcceptedEvent,
        savedAt: Date.now()
      }
    },

    persistManifest (active) {
      if (!this.sessionId) return
      try {
        const storage = require('@system.storage')
        storage.set({
          key: ACTIVE_MANIFEST_KEY,
          value: JSON.stringify(this.buildManifest(active))
        })
      } catch (err) {
        this.errorText = '会话索引保存失败'
      }
    },

    stopCapture () {
      if (!this.sessionId) return
      if (this.swingActive) this.finishSwing(Date.now())
      if (this.pendingCandidate) {
        this.commitCandidate(this.pendingCandidate)
        this.pendingCandidate = null
      }
      this.safeStopSensor()
      if (this.stageActive) this.toggleStage()
      this.flushChunk()
      this.endedAt = Date.now()
      this.stateText = '已停止'
      this.message = '已停止，可生成导出索引'
      this.persistManifest(false)
    },

    prepareExport () {
      this.exportRequested = true
      if (this.running) this.stopCapture()
      if (this.chunkEvents.length) this.flushChunk()
      this.tryPrepareExport()
    },

    tryPrepareExport () {
      if (!this.exportRequested || this.exportPrepared) return
      if (this.pendingStorageWrites > 0) {
        this.stateText = '正在保存'
        this.message = '等待数据块写入 ' + this.pendingStorageWrites
        return
      }
      this.exportPrepared = true
      const manifest = this.buildManifest(false)
      manifest.session.exportedAt = Date.now()
      manifest.export = {
        storageManifestKey: EXPORT_MANIFEST_KEY,
        chunkKeys: this.chunkRefs.map(function (item) { return item.key }),
        transport: this.interconnectSender && this.interconnectSender.available
          ? 'system.interconnect-fragment-v1' : 'storage'
      }
      this.exportViaInterconnect(manifest)
    },

    exportViaInterconnect (manifest) {
      const vm = this
      if (!this.interconnectSender || !this.interconnectSender.available) {
        this.exportViaStorage(manifest)
        return
      }
      this.interconnectSending = true
      this.interconnectProgress = '正在发送…'
      this.stateText = '导出中'
      this.message = '通过 interconnect 发送到 AstroBox'

      const storage = require('@system.storage')
      const chunkRecords = []
      let loaded = 0
      let failed = 0
      const total = this.chunkRefs.length

      if (total === 0) {
        this.sendInterconnectBatch(manifest, [])
        return
      }

      for (let i = 0; i < total; i = i + 1) {
        const ref = this.chunkRefs[i]
        storage.get({
          key: ref.key,
          default: '',
          success: function (data) {
            const raw = typeof data === 'string' ? data : data && data.value
            if (raw) {
              try {
                chunkRecords[i] = JSON.parse(raw)
              } catch (err) {
                chunkRecords[i] = null
                failed = failed + 1
              }
            } else {
              failed = failed + 1
            }
            loaded = loaded + 1
            if (loaded === total) {
              if (failed > 0 || chunkRecords.filter(Boolean).length !== total) {
                vm.handleExportReadFailure(manifest, failed)
              } else {
                vm.sendInterconnectBatch(manifest, chunkRecords)
              }
            }
          },
          fail: function () {
            failed = failed + 1
            loaded = loaded + 1
            if (loaded === total) {
              vm.handleExportReadFailure(manifest, failed)
            }
          }
        })
      }
    },

    handleExportReadFailure (manifest, failedCount) {
      this.interconnectSending = false
      this.interconnectError = 'chunk_read_fail_' + failedCount
      this.exportPrepared = false
      this.message = '有数据块读取失败，已保留本地数据，可重试导出'
      this.exportViaStorage(manifest)
    },

    sendInterconnectBatch (manifest, chunkRecords) {
      const vm = this
      this.interconnectSender.sendExport(
        this.sessionId,
        manifest,
        chunkRecords,
        function (sent, total) {
          vm.interconnectProgress = sent + '/' + total
        },
        function (err) {
          vm.interconnectSending = false
          if (err) {
            vm.interconnectError = err
            vm.exportPrepared = false
            vm.message = 'interconnect 发送失败，回退到存储导出'
            vm.exportViaStorage(manifest)
          } else {
            vm.stateText = '已导出'
            vm.message = '已发送 ' + chunkRecords.length + ' 块到 AstroBox'
            vm.exportRequested = false
            vm.exportViaStorage(manifest)
          }
        }
      )
    },

    exportViaStorage (manifest) {
      try {
        const storage = require('@system.storage')
        const vm = this
        storage.set({
          key: EXPORT_MANIFEST_KEY,
          value: JSON.stringify(manifest),
          success: function () {
            storage.set({
              key: ACTIVE_MANIFEST_KEY,
              value: JSON.stringify(manifest)
            })
            if (!vm.interconnectSender || !vm.interconnectSender.available) {
              vm.stateText = '待导出'
              vm.message = '电脑采集器未连接，数据已保留'
              vm.exportPrepared = false
            }
          },
          fail: function () {
            vm.errorText = '导出索引保存失败'
          }
        })
      } catch (err) {
        this.errorText = '导出索引保存异常'
      }
    },

    exitApp () {
      if (this.running) {
        this.stopCapture()
        this.message = '已停止保存，正在退出'
      } else if (this.sessionId) {
        this.persistManifest(this.endedAt === 0)
      }
      this.safeStopSensor()
      const vm = this
      try {
        const router = require('@system.router')
        setTimeout(function () {
          try {
            router.back()
          } catch (err) {
            vm.stateText = '已安全停止'
            vm.message = '系统退出失败，请按实体返回键'
          }
        }, 700)
      } catch (err) {
        this.stateText = '已安全停止'
        this.message = '系统退出失败，请按实体返回键'
      }
    }
  }
</script>
