<template>
  <div class="page" onswipe="onPageSwipe" ontouchstart="onPageTouchStart" ontouchend="onPageTouchEnd">
    <div class="topBar">
      <text class="appTitle">{{appTitleText}}</text>
      <text class="timer">{{displayTimeText}}</text>
    </div>

    <div class="controlScreen" if="{{showControlScreen}}">
      <div class="controlInfo">
        <text class="controlTimer">{{elapsedText}}</text>
        <text class="controlMessage">{{message}}</text>
      </div>
      <div class="controlButtons">
        <div class="controlButtonRow">
          <div class="controlButton" onclick="startOrResumeSession">
            <text class="controlButtonText">{{controlPrimaryText}}</text>
          </div>
          <div class="controlButton" onclick="pauseSession">
            <text class="controlButtonText">{{controlPauseText}}</text>
          </div>
        </div>
        <div class="controlButtonRow">
          <div class="controlButton" onclick="finishSession">
            <text class="controlButtonText">{{controlEndText}}</text>
          </div>
          <div class="controlButton" onclick="exitApp">
            <text class="controlButtonText">退出</text>
          </div>
        </div>
      </div>
    </div>

    <div class="metricsScreen" if="{{showMetricsScreen}}">
      <div class="heroMetric">
        <text class="metricLabel">挥拍强度</text>
        <text class="heroValue">{{speedKmh}}</text>
        <text class="waveStatus">{{waveformStatus}}</text>
        <text class="waveText">{{waveformText}}</text>
      </div>

      <div class="statsGrid">
        <div class="statCard">
          <text class="statLabel">有效挥拍</text>
          <text class="statValue">{{swingCount}}</text>
        </div>
        <div class="statCard">
          <text class="statLabel">最大强度</text>
          <text class="statValue">{{bestKmh}}</text>
        </div>
      </div>

      <div class="wideMetric">
        <text class="wideLabel">预测球速</text>
        <text class="wideValue">{{shuttleKmh}} km/h</text>
      </div>
    </div>

    <div class="healthScreen" if="{{showHealthScreen}}">
      <div class="healthMetricCard">
        <text class="healthMetricLabel">当前心率</text>
        <div class="healthMetricValueRow">
          <text class="healthMetricValue">{{heartRateText}}</text>
          <text class="healthMetricUnit">bpm</text>
        </div>
      </div>
      <div class="healthMetricCard">
        <text class="healthMetricLabel">平均心率</text>
        <div class="healthMetricValueRow">
          <text class="healthMetricValue">{{averageHeartRate}}</text>
          <text class="healthMetricUnit">bpm</text>
        </div>
      </div>
      <div class="healthMetricCard">
        <text class="healthMetricLabel">最高心率</text>
        <div class="healthMetricValueRow">
          <text class="healthMetricValue">{{maximumHeartRate}}</text>
          <text class="healthMetricUnit">bpm</text>
        </div>
      </div>
      <div class="healthMetricCard healthMetricCardLast">
        <text class="healthMetricLabel">估算热量</text>
        <div class="healthMetricValueRow">
          <text class="healthMetricValue healthCalorieValue">{{estimatedCaloriesText}}</text>
          <text class="healthMetricUnit">kcal</text>
        </div>
      </div>
    </div>

    <div class="settingsScreen" if="{{showSettingsScreen}}">
      <div class="settingCard">
        <text class="settingLabel">持拍手</text>
        <div class="settingButton" onclick="cycleHand">
          <text class="settingButtonText">{{handText}}</text>
        </div>
      </div>
      <div class="settingCard">
        <text class="settingLabel">身高</text>
        <div class="heightControl">
          <div class="heightStepButton" onclick="decreaseHeight">
            <text class="heightStepButtonText">-</text>
          </div>
          <div class="heightValue" onclick="increaseHeight">
            <text class="heightValueText">{{heightInputText}}</text>
          </div>
          <div class="heightStepButton" onclick="increaseHeight">
            <text class="heightStepButtonText">+</text>
          </div>
        </div>
      </div>
      <div class="settingCard">
        <text class="settingLabel">表带</text>
        <div class="settingButton" onclick="cycleStrap">
          <text class="settingButtonText">{{strapText}}</text>
        </div>
      </div>
    </div>

    <div class="historyScreen" if="{{showHistoryScreen}}">
      <div class="historyHeader">
        <text class="historyTitle">历史回放</text>
        <text class="historyHint">{{historyCountText}}</text>
      </div>
      <list class="historyList" if="{{historyListVisible}}" bounces="true">
        <list-item for="{{historyRows}}" class="historyRow" type="historyRow" onclick="openHistoryItem($idx,$item)">
          <text class="historyRowTitle">{{$item.title}}</text>
          <text class="historyRowMeta">{{$item.meta}}</text>
        </list-item>
      </list>
      <div class="historyEmpty" if="{{historyEmptyVisible}}">
        <text class="historyEmptyText">暂无历史</text>
      </div>
    </div>

    <div class="historyDetailScreen" if="{{showHistoryDetailScreen}}">
      <div class="historyDetailHeader">
        <text class="historyDetailTitle">{{historyDetailTitle}}</text>
        <text class="historyDetailMeta">{{historyDetailMeta}}</text>
      </div>

      <div class="heroMetric historyHero">
        <text class="metricLabel historyHeroLabel">挥拍强度</text>
        <text class="heroValue historyHeroValue">{{historyDetailSpeed}}</text>
      </div>

      <div class="statsGrid historyStatsGrid">
        <div class="statCard historyStatCard">
          <text class="statLabel historyStatLabel">有效挥拍</text>
          <text class="statValue historyStatValue">{{historyDetailSwings}}</text>
        </div>
        <div class="statCard historyStatCard">
          <text class="statLabel historyStatLabel">最大强度</text>
          <text class="statValue historyStatValue">{{historyDetailBest}}</text>
        </div>
      </div>

      <div class="wideMetric historyWideMetric">
        <text class="wideLabel historyWideLabel">平均强度</text>
        <text class="wideValue historyWideValue">{{historyDetailAverage}}</text>
      </div>

      <div class="historyDeleteButton" onclick="deleteHistoryItem">
        <text class="historyDeleteText">{{historyDetailDeleteText}}</text>
      </div>
    </div>

    <div class="scoreScreen" if="{{showScoreScreen}}">
      <div class="scoreHeader">
        <text class="scoreTitle">计分</text>
        <text class="scoreHint">{{scoreStatusText}}</text>
      </div>

      <div class="scorePanel scorePanelHome">
        <div class="scoreStepButton" onclick="decreaseHomeScore">
          <text class="scoreStepText">-</text>
        </div>
        <div class="scoreMain">
          <div class="scoreLabelRow">
            <text class="scoreServeDot" if="{{homeServeVisible}}">●</text>
            <text class="scoreLabel">我方</text>
          </div>
          <text class="scoreValue">{{homeScore}}</text>
        </div>
        <div class="scoreStepButton scorePlusButton" onclick="increaseHomeScore">
          <text class="scoreStepText">+</text>
        </div>
      </div>

      <div class="scorePanel scorePanelAway">
        <div class="scoreStepButton" onclick="decreaseAwayScore">
          <text class="scoreStepText">-</text>
        </div>
        <div class="scoreMain">
          <div class="scoreLabelRow">
            <text class="scoreServeDot" if="{{awayServeVisible}}">●</text>
            <text class="scoreLabel">对方</text>
          </div>
          <text class="scoreValue">{{awayScore}}</text>
        </div>
        <div class="scoreStepButton scorePlusButton" onclick="increaseAwayScore">
          <text class="scoreStepText">+</text>
        </div>
      </div>

      <div class="scoreResetButton" onclick="resetScore">
        <text class="scoreResetText">比分清零</text>
      </div>
    </div>
  </div>
</template>

